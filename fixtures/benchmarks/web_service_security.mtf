source http_request "untrusted HTTP request body"
boundary api_service "application request boundary"
sanitizer html_escape "HTML output encoding"
sanitizer sql_params "parameterized database query"
sanitizer audit_redactor "sensitive audit-field redaction"
sink html_response "template response"
sink database_write "database write"
sink audit_stream "central audit stream"

edge http_request -> api_service "ingress"
edge api_service -> html_response "direct template response"
edge api_service -> html_escape "encode response"
edge html_escape -> html_response "safe template response"
edge api_service -> database_write "raw query"
edge api_service -> sql_params "parameter builder"
edge sql_params -> database_write "parameterized query"
edge api_service -> audit_stream "raw audit event"
edge api_service -> audit_redactor "redact audit fields"
edge audit_redactor -> audit_stream "safe audit event"

require http_request -> html_response through=html_escape severity=medium "HTML responses must be encoded"
require http_request -> database_write through=sql_params severity=high "database writes must use parameters"
require http_request -> audit_stream through=audit_redactor severity=medium "audit events must redact sensitive fields"
deny http_request -> audit_stream severity=low "raw request data must not enter audit storage"
allow http_request -> api_service -> html_escape -> html_response "reviewed encoded response"
allow http_request -> api_service -> sql_params -> database_write "reviewed parameterized query"
allow http_request -> api_service -> audit_redactor -> audit_stream "reviewed redacted audit"
