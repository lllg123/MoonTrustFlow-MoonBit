source http_request_body "external body payload"
boundary user_service "service orchestration layer"
sanitizer html_escape "html encoding checkpoint"
sink template_render "html output renderer"
edge http_request_body -> user_service "request dispatch"
edge user_service -> template_render "legacy render"
edge user_service -> html_escape "safe render prep"
edge html_escape -> template_render "safe render"
deny http_request_body -> template_render severity=high "raw request payload must not reach template rendering"
require http_request_body -> template_render through=html_escape severity=medium "html output must pass through encoding"
allow http_request_body -> user_service -> html_escape -> template_render "reviewed encoded render path"
